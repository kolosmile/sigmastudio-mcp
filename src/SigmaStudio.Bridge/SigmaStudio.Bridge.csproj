<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <RootNamespace>SigmaStudio.Bridge</RootNamespace>
    <OutputType>Exe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Pipes.AccessControl" />
    <PackageReference Include="System.ServiceModel.NetNamedPipe" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'net48'" />
    <ProjectReference Include="..\SigmaStudio.Contracts\SigmaStudio.Contracts.csproj" />
    <ProjectReference Include="..\SigmaStudio.Graph\SigmaStudio.Graph.csproj" />
  </ItemGroup>
</Project>
